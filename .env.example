# Postgres connection string (Neon / Vercel Postgres / Supabase etc.)
DATABASE_URL=postgres://user:password@host:5432/forge30
# Admin sign-in password (12+ chars). Use a long random value.
ADMIN_PASSWORD=
# Random 32+ char secret used to sign admin sessions and hash IPs: openssl rand -base64 32
SESSION_SECRET=
# Public URL, used for canonical/OG tags
NEXT_PUBLIC_SITE_URL=https://forge30.yourdomain.com
